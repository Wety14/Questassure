{
  "name": "questassure-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.6.2",
  "publisher": "DARIER--LEGRAND",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wety14/Questassure.git"
  },
  "homepage": "https://github.com/Wety14/Questassure#readme",
  "bugs": {
    "url": "https://github.com/Wety14/Questassure/issues"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:vhdl"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "questassure-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:mcp",
    "build:extension": "npx esbuild extension.js --bundle --platform=node --minify --outfile=dist/extension.js --external:vscode",
    "build:mcp": "npx esbuild mcp_server.js --bundle --platform=node --minify --outfile=dist/mcp-server.js",
    "package": "node package_vsix.js",
    "publish:ovsx": "npx ovsx publish",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.20.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "vhdl",
        "aliases": ["VHDL", "vhdl"],
        "extensions": [".vhd", ".vhdl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vhdl",
        "scopeName": "source.vhdl",
        "path": "./syntaxes/vhdl.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[vhdl]": {
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000
      }
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "questassure.ghdlPath": {
          "type": "string",
          "default": "ghdl",
          "description": "%config.ghdlPath.description%"
        },
        "questassure.stopTime": {
          "type": "string",
          "default": "1us",
          "description": "%config.stopTime.description%"
        },
        "questassure.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "en", "fr"],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.fr%"
          ],
          "description": "%config.language.description%"
        },
        "questassure.openWavesOnTestExplorerRun": {
          "type": "boolean",
          "default": true,
          "description": "%config.openWavesOnTestExplorerRun.description%"
        }
      }
    },
    "commands": [
      {
        "command": "questassure.runTestbench",
        "title": "%command.runTestbench%"
      },
      {
        "command": "questassure.compileFile",
        "title": "%command.compileFile%"
      },
      {
        "command": "questassure.showRTL",
        "title": "%command.showRTL%"
      },
      {
        "command": "questassure.generateTestbench",
        "title": "%command.generateTestbench%"
      },
      {
        "command": "questassure.generateFsmTemplate",
        "title": "%command.generateFsmTemplate%"
      },
      {
        "command": "questassure.instantiateComponent",
        "title": "%command.instantiateComponent%"
      },
      {
        "command": "questassure.openFsmDesigner",
        "title": "%command.openFsmDesigner%"
      },
      {
        "command": "questassure.copyMcpConfig",
        "title": "%command.copyMcpConfig%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == vhdl",
          "command": "questassure.runTestbench",
          "group": "1_modification"
        },
        {
          "when": "resourceLangId == vhdl",
          "command": "questassure.showRTL",
          "group": "1_modification"
        },
        {
          "when": "resourceLangId == vhdl",
          "command": "questassure.generateTestbench",
          "group": "2_generation"
        },
        {
          "when": "resourceLangId == vhdl",
          "command": "questassure.generateFsmTemplate",
          "group": "2_generation"
        },
        {
          "when": "resourceLangId == vhdl",
          "command": "questassure.instantiateComponent",
          "group": "2_generation"
        },
        {
          "when": "resourceLangId == vhdl",
          "command": "questassure.openFsmDesigner",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "questassure.runTestbench",
          "when": "resourceLangId == vhdl"
        },
        {
          "command": "questassure.showRTL",
          "when": "resourceLangId == vhdl"
        },
        {
          "command": "questassure.generateTestbench",
          "when": "resourceLangId == vhdl"
        },
        {
          "command": "questassure.generateFsmTemplate",
          "when": "resourceLangId == vhdl"
        },
        {
          "command": "questassure.instantiateComponent",
          "when": "resourceLangId == vhdl"
        },
        {
          "command": "questassure.openFsmDesigner",
          "when": "resourceLangId == vhdl"
        },
        {
          "command": "questassure.copyMcpConfig"
        }
      ]
    }
  }
}
